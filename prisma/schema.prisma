generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserMode {
  ARTISAN
  ENTREPRISE
}

enum SubscriptionStatus {
  FREE
  TRIAL
  BASIC
  PRO
  EXPIRED
}

enum DocumentType {
  DEVIS
  PROFORMA
  BC
  BR
  FACTURE
}

enum DocumentStatus {
  DRAFT
  ACCEPTED
  PROGRESS
  DELIVERED
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  name              String
  phone             String?
  country           String             @default("algeria")
  sector            String?
  mode              UserMode           @default(ARTISAN)
  language          String             @default("fr")
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialStartAt      DateTime?
  subscriptionEndAt DateTime?
  suspended         Boolean          @default(false)
  suspendedAt       DateTime?
  companyInfo       Json?              // { name, address, taxIds:{nif,nis,rc,ai}, capital, logo, signature }
  settings          Json?              // { fieldVisibility, defaultTaxRegime, defaultDocType, template }
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  accounts          Account[]
  sessions          Session[]
  resetTokens       PasswordResetToken[]
  clients           Client[]
  documents         Document[]
  templates         Template[]
  backups           Backup[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  ownedTeams        Team[]              @relation("TeamOwner")
  teamMembers       TeamMember[]
  receivedShares    DocumentShare[]     @relation("SharedWithUser")
  recurringInvoices RecurringInvoice[]
  partner           Partner?
  referrals         Referral[]          @relation("ReferredUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String  // "google" or "github"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  address   String?
  phone     String?
  email     String?
  nif       String?  // Algérie
  nis       String?
  rc        String?
  ice       String?  // Maroc
  matriculeFiscal String? // Tunisie
  siret     String?  // France
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  @@index([userId])
  @@index([name])
}

model Document {
  id            String         @id @default(cuid())
  userId        String
  clientId      String?
  type          DocumentType   @default(DEVIS)
  status        DocumentStatus @default(DRAFT)
  number        String         @default("")
  date          DateTime       @default(now())
  validUntil    DateTime?
  deliveryDate  DateTime?
  mode          UserMode       @default(ARTISAN)
  country       String         @default("algeria")
  sector        String?
  taxRegime     String         @default("tva_19")
  paymentMode   String         @default("cheque")
  items         Json           @default("[]")
  subTotalHT    Float          @default(0)
  tvaAmount     Float          @default(0)
  timbreFiscal  Float          @default(0)
  totalTTC      Float          @default(0)
  acompte       Float          @default(0)
  netAPayer     Float          @default(0)
  totalInWords  String         @default("")
  notes         String?
  customFields  Json           @default("{}")
  template      String         @default("classic")
  signature     String?
  bcRef         String?        // Lien vers Bon de Commande
  brRef         String?        // Lien vers Bon de Réception
  teamId        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  shares        DocumentShare[]
  @@index([userId])
  @@index([clientId])
  @@index([type])
  @@index([status])
  @@index([number])
  @@index([createdAt])
}

model Template {
  id           String       @id @default(cuid())
  userId       String
  name         String
  description  String?
  documentType DocumentType @default(DEVIS)
  mode         UserMode     @default(ARTISAN)
  items        Json         @default("[]")
  customFields Json         @default("{}")
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Backup {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("auto")
  fileUrl   String?
  size      Int?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([createdAt])
}

enum AdminRole {
  VIEWER
  EDITOR
  ADMIN
}

model Admin {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String
  name            String          @default("Admin")
  role            AdminRole       @default(ADMIN)
  permissions     String[]        @default([])
  twoFactorSecret String?
  twoFactorEnabled Boolean        @default(false)
  lastLogin       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  activityLogs    ActivityLog[]
  backupLogs      BackupLog[]

  @@index([email])
}

model BackupLog {
  id         String   @id @default(cuid())
  adminId    String?
  type       String   @default("auto")
  status     String   @default("pending")
  size       Int?
  fileUrl    String?
  notes      String?
  startedAt  DateTime @default(now())
  completedAt DateTime?

  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([status])
}

model Analytics {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  country        String   @default("unknown")
  visitors       Int      @default(0)
  sessions       Int      @default(0)
  pageViews      Int      @default(0)
  bounceRate     Float    @default(0)
  avgSessionTime Int      @default(0)

  @@index([date])
  @@index([country])
}

enum PartnerTier {
  AFFILIATE
  SUPER_AFFILIATE
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
}

enum CommissionType {
  DIRECT
  OVERRIDE
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

model Partner {
  id            String          @id @default(cuid())
  userId        String          @unique
  code          String          @unique
  tier          PartnerTier     @default(AFFILIATE)
  parentId      String?
  status        PartnerStatus   @default(PENDING)
  stats         Json            @default("{}")
  appliedAt     DateTime        @default(now())
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Partner?        @relation("PartnerHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Partner[]       @relation("PartnerHierarchy")
  referrals     Referral[]
  commissions   Commission[]
  payouts       Payout[]
  courses       PartnerCourse[]

  @@index([code])
  @@index([status])
  @@index([tier])
  @@index([parentId])
}

model Referral {
  id              String          @id @default(cuid())
  partnerId       String
  referredUserId  String          @unique
  status          ReferralStatus  @default(PENDING)
  convertedAt     DateTime?

  partner         Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referredUser    User            @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
}

model Commission {
  id              String          @id @default(cuid())
  partnerId       String
  amount          Float
  type            CommissionType  @default(DIRECT)
  subscriptionId  String?
  status          String          @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime        @default(now())

  partner         Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
}

model Payout {
  id              String          @id @default(cuid())
  partnerId       String
  totalAmount     Float
  status          PayoutStatus    @default(PENDING)
  requestedAt     DateTime        @default(now())
  paidAt          DateTime?

  partner         Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
}

model PartnerCourse {
  id          String    @id @default(cuid())
  partnerId   String
  moduleId    String
  completedAt DateTime?
  score       Int?

  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, moduleId])
  @@index([partnerId])
}

model ActivityLog {
  id              String   @id @default(cuid())
  adminId         String?
  userId          String?
  action          String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entity          String   // USER, DOCUMENT, SUBSCRIPTION, SYSTEM
  entityId        String?
  details         Json?
  ipAddress       String?
  createdAt       DateTime @default(now())

  admin           Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model SystemMetric {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  totalUsers      Int      @default(0)
  activeUsers     Int      @default(0)
  totalDocuments  Int      @default(0)
  totalRevenue    Float    @default(0)
  dbSize          Float    @default(0)
  uptime          Int      @default(0)

  @@index([timestamp])
}

enum TeamMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SharePermission {
  VIEW
  EDIT
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  country   String   @default("unknown")
  locale    String   @default("fr")
  sessionId String?
  userId    String?
  timestamp DateTime @default(now())

  @@index([path])
  @@index([timestamp])
  @@index([country])
  @@index([sessionId])
}

model Team {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  ownerId   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  owner     User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  invites   TeamInvite[]
  documents Document[]

  @@index([ownerId])
  @@index([slug])
}

model TeamMember {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())

  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamInvite {
  id        String       @id @default(cuid())
  teamId    String
  email     String
  token     String       @unique
  role      TeamMemberRole @default(MEMBER)
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  expiresAt DateTime

  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
  @@index([token])
}

model DocumentShare {
  id              String           @id @default(cuid())
  documentId      String
  sharedWithId    String
  permission      SharePermission  @default(VIEW)
  createdAt       DateTime         @default(now())

  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWith      User             @relation("SharedWithUser", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([documentId, sharedWithId])
  @@index([documentId])
  @@index([sharedWithId])
}

model RecurringInvoice {
  id            String              @id @default(cuid())
  userId        String
  name          String
  documentType  DocumentType        @default(DEVIS)
  frequency     RecurringFrequency  @default(MONTHLY)
  nextDate      DateTime
  lastGenerated DateTime?
  active        Boolean             @default(true)
  template      Json                @default("{}")   // { items, clientInfo, ... }
  settings      Json                @default("{}")   // { emailOnGenerate, autoSend, ... }
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextDate])
  @@index([active])
}
