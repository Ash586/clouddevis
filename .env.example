# ⚠️  COPY THIS FILE TO .env AND FILL IN REAL VALUES
# NEVER commit .env to git (already gitignored)
#
# Secrets to rotate before production:
#   - DATABASE_URL: generate new credentials at your DB provider
#   - JWT_SECRET: run `node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"`
#   - SENTRY_AUTH_TOKEN: generate at https://sentry.io/settings/account/api/auth-tokens/

# Sentry — https://clouddevis.sentry.io
SENTRY_DSN=https://<key>@o<org-id>.ingest.de.sentry.io/<project-id>
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org-id>.ingest.de.sentry.io/<project-id>
SENTRY_ENVIRONMENT=development
SENTRY_ORG=clouddevis
SENTRY_PROJECT=clouddevis-web
SENTRY_AUTH_TOKEN=

DATABASE_URL=postgresql://user:password@host:port/db?sslmode=require

# ── Field encryption (AES-256-GCM) — NIF/NIS/RC/AI/IBAN ──────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Losing this key = losing all encrypted PII. Store in a secrets manager.
# Rotating requires a re-encryption migration of existing DB rows.
FIELD_ENCRYPTION_KEY=<64-hex-chars>
JWT_SECRET=
ADMIN_JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis — rate limiting across Vercel instances (⚠️ required for multi-instance production)
# Create at https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mixpanel — https://mixpanel.com (project settings → token)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# LemonSqueezy — https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_VARIANT_STANDARD=
LS_VARIANT_PRO=
LS_VARIANT_MAX=

# Wise — virement manuel (optionnel)
WISE_BENEFICIARY=
WISE_IBAN=
WISE_BIC=
WISE_BANK=Wise
WISE_CURRENCY=DZD
