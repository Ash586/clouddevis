    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
