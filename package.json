{
  "name": "cd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "build:prod": "npx prisma generate && npx prisma migrate deploy && next build",
    "analyze": "ANALYZE=true npm run build",
    "db:push": "npx prisma db push",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run --config vitest.config.api.ts tests/api",
    "test:e2e": "playwright test",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "mobile:dev": "npx cap sync && npx cap open android",
    "mobile:dev-device": "node scripts/cap-dev.mjs dev && npx cap open android",
    "mobile:prod": "node scripts/cap-dev.mjs prod"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.0",
